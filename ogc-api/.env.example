# Copy to .env and edit. Compose reads .env automatically; it is gitignored
# and excluded from the Docker build context.

# Host interface and port the API is published on.
# API_BIND=127.0.0.1
# API_PORT=8080

# Public base URL written into the OGC links. Must match how clients reach the
# API, or every href in the landing page, process and job documents is wrong.
# BASE_URL=https://ogc.example.com

# Hours since last access before a job is evicted from memory.
# JOB_MAX_AGE_HOURS=48

# Comma-separated origins allowed to call the API from a browser.
# Set this explicitly in production — the default "*" lets any site call it.
# CORS_ALLOWED_ORIGINS=https://console.example.com

# BAG WFS queried by plot-bag-matching-pdok. Point at a mirror or test double.
# PDOK_BAG_WFS_URL=https://service.pdok.nl/lv/bag/wfs/v2_0
